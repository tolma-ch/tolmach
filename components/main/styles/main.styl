html, body 
	height 100%

body > .main 
	min-height 100%
	padding-bottom 72px
	height auto

.stripy-heading
	text-align center
	display table
	width 100%
	box-sizing border-box
	padding 0 58px

	&__before,
	&__after
		display table-cell
		width 50%

		&:before
			display block
			content ""	
			border-bottom 1px solid #e8e8e8
			height 50%
			width 100%
			position relative
			top -7px

	&__text
		display table-cell
		padding 40px 20px
		white-space nowrap
		font-size 24px
		color #666
		font-weight 200


.iconed-features
	text-align center
	max-width 1024px
	padding 0 58px
	margin 0
	box-sizing content-box	

	&__list
		text-align center
		margin 0 -80px
		padding 0
		
		list-style-type none

	&__item
		width 230px
		margin 0 80px 70px
		display inline-block

		&-header
			text-align center
			font-size 20px
			font-weight 600

		&-text
			font-size 16px
			line-height 19px
			font-weight 200
			

	&__text
		color #4d4d4d
		text-align left

.btn-scroll-up
	display none
	position fixed
	left 10%
	top 60px
	background rgba(67, 142, 185, 0.15)
	color #fff
	font-size 2em

	&:hover
		color #fff
		background rgba(67, 142, 185, 0.25)
		text-shadow 0 0 4px #fff
		
