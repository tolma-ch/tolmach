@font-face
	font-family Arvo
	src url('../fonts/Arvo-Regular.ttf')

@font-face
	font-family Arvo
	font-weight 600
	src url('../fonts/Arvo-Bold.ttf')

@font-face
	font-family Arvo
	font-style italic
	src url('../fonts/Arvo-Italic.ttf')

@font-face
	font-family Arvo
	font-style italic
	font-weight 600
	src url('../fonts/Arvo-BoldItalic.ttf')

$fontFamily = 'Ubuntu', 'Helvetica Neue', Helvetica, Arial, sans-serif

* { 
	font-family $fontFamily
}
