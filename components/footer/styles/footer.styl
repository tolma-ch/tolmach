.footer
	background #666
	height 72px
	position relative
	margin-top -72px
	clear both

	&-logo 
		margin 0 !important
		height 100%

		a 
			display block
			height 100%

			img 
				margin 22px 0 21px

	&-social
		display block
		height 24px
		padding 24px 0
		margin 0
		vertical-align middle

		&__icon 
			display block
			width 100%
			height 100%
			background url('/components/footer/images/social.png') no-repeat

		&__item 
			display inline-block
			list-style-type none
			height 24px
			width 24px
			margin-left 10px

			&_vk
				background-position 0 0

				&:hover
					background-position 0 -24px

			&_gp
				background-position -24px 0

				&:hover
					background-position -24px -24px

			&_tw
				background-position -48px 0

				&:hover
					background-position -48px -24px

			&_fb
				background-position -72px 0

				&:hover
					background-position -72px -24px

	&-fixed
		&-top,
		&-bottom 
			position fixed

	&-container 
		padding-left 10px
		padding-right 20px
		height 72px
		max-width 1024px
		margin 0 auto

		.container 
			padding-left 0
			padding-right 0

