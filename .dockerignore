# Version control / CI metadata (not needed inside the image)
.git
.gitignore
.github
.drone.yml

# JS dependencies are installed inside the image via `npm ci`
node_modules

# Generated frontend assets (built in the Dockerfile `assets` stage)
tolmach/static/assets/
tolmach/static/dist/
tolmach/static/js/bootstrap.min.js
tolmach/static/js/jquery-2.0.3.min.js
tolmach/static/js/reconnecting-websocket.min.js
tolmach/static/js/screenfull.js

# Python bytecode / caches
**/__pycache__
**/*.pyc
**/*.pyo

# Generated translation binaries (recompiled by `django-admin compilemessages`)
**/*.mo
**/*.pot

# Local / runtime junk
*.log
.reload
.env
tmp
.idea
.vscode
*.code-workspace

# collectstatic output and user uploads (mounted as volumes at runtime)
/static/
/media/
