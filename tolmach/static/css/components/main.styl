html, body
	height 100%
	font-family 'Ubuntu', 'Helvetica Neue', Helvetica, Arial, sans-serif


body > .main 
	min-height 100%
	height auto

.stripy-heading
	text-align center
	display table
	width 100%
	box-sizing border-box

	&__before,
	&__after
		display table-cell
		width 50%

		&:before
			display block
			content ""	
			border-bottom 1px solid $grayBorder
			height 50%
			width 100%
			position relative
			top -7px

	&__text
		display table-cell
		padding 40px 20px
		white-space nowrap
		font-size 24px
		color #666
		font-weight 200


.iconed-features
	text-align center
	padding 0 0 100px
	margin 0
	box-sizing content-box	

	&__list
		text-align center
		margin 0 -90px
		padding 0
		
		list-style-type none

	&__item
		width 230px
		margin 0 80px 70px
		display inline-block

		&-header
			text-align center
			font-size 20px
			font-weight 600

		&-text
			font-size 16px
			line-height 19px
			font-weight 200
			

	&__text
		color #4d4d4d
		text-align left

.btn-scroll-up
	display none
	position fixed
	left 10%
	top 60px
	background rgba(67, 142, 185, 0.15)
	color #fff
	font-size 2em

	&:hover
		color #fff
		background rgba(67, 142, 185, 0.25)
		text-shadow 0 0 4px #fff

.profile-container
	max-width 1004px
	margin: 0 auto;

.profile-sidebar
	width 240px
	margin-right 20px
	float left

.profile-content
	margin-left 260px
	margin-right 0
	margin-top 0
	min-height 100%
	padding 0

@media (max-width: 755px)
	.profile-content
		margin 0
	.profile-sidebar
		width auto
		margin 0
		float none

.main-content
	clearfix()

.button
	display inline-block
	padding 5px 20px

	&_gray
		background #d9d9d9
		color #fff
		font-weight 300

.scrollable
	height 600px
	overflow-x hidden
	overflow-y auto
	margin-right -12px
	margin-left -12px
	padding-right 12px
	padding-left 12px
	min-height 400px

