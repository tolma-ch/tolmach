.user-statistics
	padding-top 20px

	&__title
		color #6f6f6e
		font-size 28px

	&__translations
		clearfix()

		&-rate
			padding 10px 0

			&-item
				text-align center
				vertical-align middle

		&-language
			width 24px
			height 24px
			display inline-block

		&-direction
			margin 0 5px
			font-size 21px
			vertical-align 4px

			&_small
				font-size 16px
				vertical-align 5px
				color #9c9b9b


	&-list
		width 465px
		padding-left 0
		float left
		margin-top 20px
		margin-left 0
		clearfix()

		&__item
			list-style-type none
			float left
			width 29%
			margin-right 4%

	&-column
		box-sizing border-box
		height 270px
		position relative
		background url('/static/images/profile-data/column-back.png')

		&__value
			width 48%
			position absolute
			bottom 0
			background #666

			&_l
				left 0

			&_r
				right 0

	&__total
		float left
		/*height 270px*/
		padding 55px 0
		margin-top 20px
		max-width 270px

		&-title,
		&-sentences
			font-size 26px
			font-weight 300
			color $grayText

		&-number
			font-size 110px
			color $headerColor
			line-height 82px

	&__recent-progress
		text-align center

		&-title
			.stripy-heading__text
				padding 10px 20px

		&-table
			font-size 16px
			font-weight 300
			margin-bottom 20px

	&-table
		width 100%

		&__row
			&:nth-child(2n)
				background #f5f5f5

		&__title
			padding 0 10px
			max-width 197px
			overflow hidden
			text-overflow ellipsis
			white-space nowrap
			text-align left

		&__progress
			padding 8px 0
			width 445px

			.progress-bar
				height 18px
				background #d9d9d9

				&__value
					color #fff
					line-height 18px

		&__languages
			padding 5px 10px 0
			text-align right


@media (max-width: 1242px)
	.user-statistics
		position relative
		clearfix()

		&-list
			width 100%

		&__total
			float none
			padding 0
			margin-top 0

			&-title,
			&-number
			&-sentences
				font-size 14px
				display inline-block
				line-height 1

		&-table
			&__progress
				padding 0
				width auto

				.progress-bar
					width 100%
					height auto
					background transparent

					&__gauge
						visibility hidden

					&__value
						position relative
						line-height 22px
						font-size 20px
						text-align center
						width 100%
						color $entryColor

			&__languages
				padding 5px 10px 0
				text-align right

@media (max-width: 495px)
	.user-statistics
		&-list
			width auto
			float none

			&__item
				list-style-type none
				float none
				width auto
				margin-right 20px


.user-avatar
	border-radius 50%
	border 1px solid #999
	width 40px
	height 40px
	img
		width 40px
		height 40px
		border 1px solid white
		border-radius 50%