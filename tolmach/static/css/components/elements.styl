.switcher
	margin 0
	display inline-flex

	&__button
		display inline-block
		height 32px
		padding 0 25px
		line-height 32px
		color $mainBlue
		text-decoration none
		cursor pointer
		border none
		&:hover
			text-decoration none
		> span
			border-bottom 1px dashed $mainBlue
			display inline-block
			line-height 17px

		&_active
			background $mainBlue
			color #fff
			cursor default
			&:hover
				color #fff
				text-decoration none
			span
				border-bottom none

	&__button-content
		display inline-block
		margin-bottom 2px
		vertical-align middle
		line-height 1
		white-space normal
		font-weight 300
		font-size 13px

	&__button-icon
		display inline-block
		vertical-align middle
		margin-right 5px
		font-size 1.3em


.languages
	display inline-block
	font-size 18px
	margin-top -5px


.progress-bar
	position relative
	width 100%
	box-shadow none
	background #CCC
	height 1.5em
	margin: 4px 0

	&__gauge
		float: left;
		height 100%

	&__value
		position absolute
		width 100%
		height 100%
		line-height 1.5em
		text-align center
		top 0
		left 0

.key
	display: inline-block;
	padding: 1px 4px;
	border: 1px solid grey;
	border-radius: 3px;
	margin: -1px 1px;
	box-shadow: 1px 1px 1px rgba(0,0,0,.5);
	font-style normal