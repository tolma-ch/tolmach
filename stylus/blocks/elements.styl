.languages
	display inline-block
	font-size 18px
	margin-top -5px


.progress-bar
	position relative
	width 100%
	box-shadow none
	background #CCC
	height 1.5em
	margin: 4px 0

	&__gauge
		float: left;
		height 100%

	&__value
		position absolute
		width 100%
		height 100%
		line-height 1.5em
		text-align center
		top 0
		left 0

.key
	display: inline-block;
	padding: 1px 4px;
	border: 1px solid grey;
	border-radius: 3px;
	margin: -1px 1px;
	box-shadow: 1px 1px 1px rgba(0,0,0,.5);
	font-style normal